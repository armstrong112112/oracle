# Copy this file to .env and adjust values for your local environment.

# Backend API base URL used by Nitro server routes and proxy utilities.
# Example: http://localhost:3001
NUXT_API_BASE_URL=http://localhost:3001

# Enable mock mode for server/api routes when you want to avoid calling the real backend.
# Set to false to use proxying to the backend instead.
NUXT_PUBLIC_USE_MOCKS=true

# Public Vendure GraphQL endpoint used by shop-related features.
# Example: http://localhost:3100/shop-api
NUXT_PUBLIC_VENDURE_URL=http://localhost:3100/shop-api

# Optional Telegram bot token used by Telegram auth/integration flows.
NUXT_TELEGRAM_TOKEN=

# Optional: override the default app port when running locally.
# NUXT_PORT=3000
